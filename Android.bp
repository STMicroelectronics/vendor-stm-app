// Install the prebuilt ST apk

// ST Perf view prebuilt application
// Sources available in gerrit : android-brillo-mpu/app_stperf
android_app_import {

    name: "STPerf",
    apk: "STPerf.apk",

    certificate: "platform",
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    product_specific: true,

}

// ST Video application
// Sources available in gerrit : android-brillo-mpu/app_stvideo
android_app_import {

    name: "STVideo",
    apk: "STVideo.apk",

    certificate: "platform",
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    product_specific: true,

}

// ST Camera prebuilt application
// Sources available in gerrit : android-brillo-mpu/app_stcamera
android_app_import {

    name: "STCamera",
    apk: "STCamera.apk",

    privileged: true,
    certificate: "platform",
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    product_specific: true,

}

// ST Graphics prebuilt application
// Sources available in gerrit : mpugraphics/android/app_stgraphics
android_app_import {

    name: "STGraphics",
    apk: "STGraphics.apk",
    privileged: true,

    certificate: "platform",
    product_specific: true,

}

// ST Vulkan prebuilt application
// Sources available in gerrit : github KhronosGroup/Vulkan-Samples
// Sources patches in mpugraphics/android/KhronosGroup/Vulkan-Samples (only instancing sample)
android_app_import {

    name: "STVulkan",
    apk: "STVulkan.apk",

    certificate: "platform",
    product_specific: true,

}

// ST App Launcher
// Sources available in gerrit : android-brillo-mpu/app_stlauncher
android_app_import {

    name: "STLauncher",
    apk: "STLauncher.apk",

    privileged: true,
    certificate: "platform",
    system_ext_specific: true,

    overrides: [
        "Launcher2",
        "Launcher3",
        "Launcher3QuickStep",
    ],

}
